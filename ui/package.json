{
  "name": "photoview-ui",
  "version": "0.0.1",
  "repository": {
    "type": "git",
    "url": "https://github.com/loiuscypher/photoview.git",
    "directory": "ui"
  },
  "license": "GPL-3.0",
  "description": "UI app for Photoview",
  "scripts": {
    "start": "vite --host=0.0.0.0",
    "mon": "nodemon",
    "build": "vite build",
    "build:dev": "vite build --mode development --sourcemap --minify=false",
    "lint": "eslint ./src --max-warnings 0 --config .eslintrc.js",
    "lint:ci": "eslint ./src --config .eslintrc.js --no-color --fix-dry-run > eslint-report.txt",
    "lint:staged": "lint-staged",
    "format:check": "prettier --check .",
    "test": "vitest",
    "test:ci": "CI=true vitest --reporter=junit --reporter=verbose --run --coverage",
    "genSchemaTypes": "graphql-codegen",
    "genSchemaOld": "apollo client:codegen --target=typescript --globalTypesFile=src/__generated__/globalTypes.ts --passthroughCustomScalars && prettier --write */**/__generated__/*.ts",
    "extractTranslations": "i18next -c i18next-parser.config.js"
  },
  "dependencies": {
    "@apollo/client": "^4.2.1",
    "@headlessui/react": "^2.2.10",
    "@tailwindcss/postcss": "^4.3.0",
    "@vitejs/plugin-react": "^6.0.2",
    "classnames": "^2.5.1",
    "copy-to-clipboard": "^4.0.2",
    "dayjs": "^1.11.21",
    "i18next": "^26.3.0",
    "js-cookie": "^3.0.8",
    "luxon": "^3.7.2",
    "mapbox-gl": "^3.24.0",
    "react": "^19.2.7",
    "react-blurhash": "^0.3.0",
    "react-datepicker": "^9.1.0",
    "react-dom": "^19.2.7",
    "react-helmet": "^6.1.0",
    "react-hook-form": "^7.77.0",
    "react-i18next": "^17.0.8",
    "react-router-dom": "^7.16.0",
    "react-swipeable": "^7.0.2",
    "styled-components": "^6.4.2",
    "tailwind-override": "^0.6.1",
    "url-join": "^5.0.0",
    "vite": "^8.0.16",
    "vite-plugin-svgr": "^5.2.0"
  },
  "devDependencies": {
    "@graphql-codegen/add": "^7.0.1",
    "@graphql-codegen/cli": "^7.1.2",
    "@graphql-codegen/typescript": "^6.0.2",
    "@graphql-codegen/typescript-operations": "^6.0.3",
    "autoprefixer": "^10.5.0",
    "postcss": "^8.5.15",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "graphql": "^16.14.0"
  },
  "prettier": {
    "trailingComma": "es5",
    "tabWidth": 2,
    "semi": false,
    "singleQuote": true,
    "arrowParens": "avoid"
  },
  "lint-staged": {
    "*.{ts,tsx,js,json,css,md,graphql}": "prettier --write",
    "*.{js,ts,tsx}": "eslint --cache --fix --max-warnings 0"
  },
  "browserslist": {
    "production": [
      "defaults",
      "not ie 11",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
